OPENAI_API_KEY=
PIM_XLSX=
FAMILY_MAP_XLSX=
PIM_VERBOSE=1
PRODUCT_DB_BACKEND=postgres
PRODUCT_DATABASE_URL=postgresql://postgres:change-me@postgres:5432/productfinder
PRODUCT_DB_IMPORT_STATEMENT_TIMEOUT_MS=600000

# Public domain used by the reverse proxy
APP_DOMAIN=laiting.disano.it
ACME_EMAIL=admin@example.com

# App security
ENABLE_DEBUG_ENDPOINTS=false
ADMIN_TOKEN=
CORS_ALLOWED_ORIGINS=https://laiting.disano.it

# Auth
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_EXPIRE_MINUTES=120
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe1234
ADMIN_BOOTSTRAP_NAME=Administrator

# OAuth2 / SSO login (Microsoft Entra ID defaults)
OAUTH2_ENABLED=true
OAUTH2_PROVIDER_NAME=Microsoft Entra ID
OAUTH2_TENANT_ID=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=https://laiting.disano.it/auth/oauth/callback
OAUTH2_ALLOWED_DOMAINS=disano.it
OAUTH2_AUTO_APPROVE=true
OAUTH2_DEFAULT_ROLE=user
OAUTH2_DEFAULT_COUNTRY=
OAUTH2_ADMIN_EMAILS=
LOCAL_LOGIN_ENABLED=false
LOCAL_SIGNUP_ENABLED=false

# Email
EMAIL_DELIVERY_PROVIDER=graph
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_FROM_EMAIL=laiting@disano.it

# Rate limiting
RATE_LIMIT_STORE=shared
RATE_LIMIT_DATABASE_URL=

# Postgres service values used by docker-compose.prod.yml
POSTGRES_DB=productfinder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Optional runtime limits
IMAGE_PARSE_MAX_BYTES=8388608
PDF_PARSE_MAX_UPLOAD_BYTES=10485760
