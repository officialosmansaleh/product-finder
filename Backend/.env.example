OPENAI_API_KEY=
# Optional comma-separated model priority lists.
# Leave blank to use the backend defaults.
OPENAI_TEXT_MODELS=
OPENAI_IMAGE_MODELS=
PIM_XLSX=
FAMILY_MAP_XLSX=
PIM_VERBOSE=1
PRODUCT_DB_BACKEND=postgres
PRODUCT_DATABASE_URL=postgresql://user:password@localhost:5432/productfinder
PRODUCT_DB_IMPORT_STATEMENT_TIMEOUT_MS=600000

# Security
ENABLE_DEBUG_ENDPOINTS=false
ADMIN_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth
AUTH_DB_PATH=data/auth.db
AUTH_DATABASE_URL=
# Example PostgreSQL:
# AUTH_DATABASE_URL=postgresql://user:password@localhost:5432/productfinder
AUTH_JWT_SECRET=change-me
AUTH_TOKEN_EXPIRE_MINUTES=120
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe1234
ADMIN_BOOTSTRAP_NAME=Administrator

# OAuth2 / SSO login (optional locally)
OAUTH2_ENABLED=false
OAUTH2_PROVIDER_NAME=Microsoft Entra ID
OAUTH2_TENANT_ID=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:8000/auth/oauth/callback
OAUTH2_ALLOWED_DOMAINS=
OAUTH2_AUTO_APPROVE=true
OAUTH2_DEFAULT_ROLE=user
OAUTH2_DEFAULT_COUNTRY=
OAUTH2_ADMIN_EMAILS=
LOCAL_LOGIN_ENABLED=true
LOCAL_SIGNUP_ENABLED=true

# Email
EMAIL_DELIVERY_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_FROM_EMAIL=

# Rate limiting
RATE_LIMIT_STORE=shared
RATE_LIMIT_DATABASE_URL=

# Optional runtime limits
IMAGE_PARSE_MAX_BYTES=8388608
PDF_PARSE_MAX_UPLOAD_BYTES=10485760
